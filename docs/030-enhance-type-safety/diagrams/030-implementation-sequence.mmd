flowchart TD
    %% Implementation Sequence Workflow - 4 Week Timeline

    subgraph "Week 1: Foundation Setup"
        W1D1[Day 1-2: Create Enums<br/>- LinkType enum<br/>- ValidationLevel enum<br/>- FileType enum]
        W1D3[Day 3-4: Create DTOs<br/>- ValidationStatistics<br/>- Link DTO<br/>- Factory methods]
        W1D5[Day 5: Testing Setup<br/>- Pest test structure<br/>- PHPStan baseline<br/>- CI/CD updates]

        W1D1 --> W1D3 --> W1D5
    end

    subgraph "Week 2: Collection Implementation"
        W2D1[Day 1-2: Core Collections<br/>- ValidationResultCollection<br/>- LinkCollection<br/>- Collection interfaces]
        W2D3[Day 3-4: Service Integration<br/>- Update return types<br/>- Maintain compatibility<br/>- Internal service calls]
        W2D5[Day 5: Validation<br/>- Integration testing<br/>- Performance benchmarks<br/>- Rollback testing]

        W2D1 --> W2D3 --> W2D5
    end

    subgraph "Week 3: Union Type Elimination"
        W3D1[Day 1: Preparation<br/>- Identify all unions<br/>- Create helpers<br/>- Update bindings]
        W3D2[Day 2-3: Core Updates<br/>- Remove ValidationConfig union<br/>- Update LinkValidationService<br/>- Fix method signatures]
        W3D4[Day 4: Command Updates<br/>- Update command classes<br/>- Boundary conversions<br/>- Feature testing]
        W3D5[Day 5: Integration<br/>- Full app testing<br/>- PHPStan validation<br/>- Performance checks]

        W3D1 --> W3D2 --> W3D4 --> W3D5
    end

    subgraph "Week 4: Interface Segregation"
        W4D1[Day 1-2: Interface Design<br/>- Create segregated interfaces<br/>- Composite pattern<br/>- Update implementations]
        W4D3[Day 3-4: DI Updates<br/>- Container bindings<br/>- Service refactoring<br/>- Architecture tests]
        W4D5[Day 5: Final Validation<br/>- Complete test suite<br/>- Documentation<br/>- Performance optimization]

        W4D1 --> W4D3 --> W4D5
    end

    %% Cross-week dependencies
    W1D5 --> W2D1
    W2D5 --> W3D1
    W3D5 --> W4D1

    %% Parallel Testing Activities
    subgraph "Continuous Testing"
        TestUnit[Unit Tests<br/>Pest Framework<br/>All 4 weeks]
        TestIntegration[Integration Tests<br/>Week 2-4]
        TestArchitecture[Architecture Tests<br/>Week 3-4]
        TestPerformance[Performance Tests<br/>Week 4]
    end

    %% Risk Mitigation Points
    subgraph "Risk Checkpoints"
        Risk1[Week 1 Checkpoint<br/>- Enum validation<br/>- Test coverage<br/>- PHPStan compliance]
        Risk2[Week 2 Checkpoint<br/>- Collection performance<br/>- Memory usage<br/>- Compatibility check]
        Risk3[Week 3 Checkpoint<br/>- Breaking change impact<br/>- Migration success<br/>- Rollback readiness]
        Risk4[Week 4 Checkpoint<br/>- Final validation<br/>- Performance metrics<br/>- Documentation complete]
    end

    W1D5 --> Risk1
    W2D5 --> Risk2
    W3D5 --> Risk3
    W4D5 --> Risk4

    %% Success Criteria
    Success[Implementation Success<br/>- Type Safety: 89% to 96%<br/>- PHPStan Max Compliance<br/>- Zero Union Types<br/>- All Tests Passing]

    Risk4 --> Success

    %% Rollback Points
    Rollback1[Rollback Option 1<br/>After Week 1<br/>Keep enums, revert rest]
    Rollback2[Rollback Option 2<br/>After Week 2<br/>Keep collections, revert unions]
    Rollback3[Rollback Option 3<br/>After Week 3<br/>Partial interface rollback]

    Risk1 -.->|If issues| Rollback1
    Risk2 -.->|If issues| Rollback2
    Risk3 -.->|If issues| Rollback3

    %% Styling - WCAG 2.1 AA Compliant Colors (4.5:1 contrast ratio minimum)
    classDef weekBox fill:#ffffff,stroke:#1976d2,stroke-width:2px,color:#000000
    classDef dayBox fill:#ffffff,stroke:#4a148c,stroke-width:1px,color:#000000
    classDef testBox fill:#ffffff,stroke:#1b5e20,stroke-width:1px,color:#000000
    classDef riskBox fill:#ffffff,stroke:#e65100,stroke-width:1px,color:#000000
    classDef successBox fill:#ffffff,stroke:#1b5e20,stroke-width:3px,color:#000000
    classDef rollbackBox fill:#ffffff,stroke:#b71c1c,stroke-width:1px,stroke-dasharray: 5 5,color:#000000

    class W1D1,W1D3,W1D5,W2D1,W2D3,W2D5,W3D1,W3D2,W3D4,W3D5,W4D1,W4D3,W4D5 dayBox
    class TestUnit,TestIntegration,TestArchitecture,TestPerformance testBox
    class Risk1,Risk2,Risk3,Risk4 riskBox
    class Success successBox
    class Rollback1,Rollback2,Rollback3 rollbackBox
