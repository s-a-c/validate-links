includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    # Level 10 - Maximum strictness beyond 'max'
    level: 10

    paths:
        - app
        - bootstrap
        - config
        - tests

    excludePaths:
        - vendor
        - vendor/*
        - vendor/**/*
        - bootstrap/cache (?)
        - storage/logs (?)
        - storage/framework (?)
        - storage/app (?)
        - node_modules (?)

    errorFormat: table
    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'
    editorUrlTitle: '%%relFile%%:%%line%%'

    # File extensions to analyze
    fileExtensions:
        - php

    tmpDir: reports/phpstan

    ignoreErrors:
        # Temporary ignores for gradual level 10 adoption
        # Remove these as violations are fixed

    # Advanced type checking - Level 10 strictness
    checkExplicitMixed: true
    checkImplicitMixed: true
    checkMissingCallableSignature: true
    checkMissingVarTagTypehint: true
    checkArgumentsPassedByReference: true
    checkMaybeUndefinedVariables: true
    checkNullables: true
    checkThisOnly: false
    checkUnionTypes: true
    checkExplicitMixedMissingReturn: true
    checkPhpDocMissingReturn: true
    checkPhpDocMethodSignatures: true
    checkExtraArguments: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkUninitializedProperties: true
    checkDynamicProperties: true
    checkClassCaseSensitivity: true
    checkFunctionArgumentTypes: true
    checkMissingTypehints: true
    reportMaybes: true
    reportStaticMethodSignatures: true
    reportMagicMethods: true
    reportMagicProperties: true
    reportAnyTypeWideningInVarTag: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportPossiblyNonexistentGeneralArrayOffset: true

    # PHPDoc and type handling
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    reportWrongPhpDocTypeInVarTag: true

    # PHP 8.4 specific settings
    phpVersion: 80400

    # UTF-8 and encoding settings
    universalObjectCratesClasses:
        - stdClass

    # Laravel Zero specific configurations
    scanFiles:
        - bootstrap/app.php
        - bootstrap/providers.php

    scanDirectories:
        - app/Commands
        - app/Services
        - app/Contracts
        - app/Enums
        - app/Exceptions
        - app/Providers
        - app/Services/ValueObjects
        - app/Services/Formatters
        - app/Services/Contracts

    # Performance settings optimized for large codebase
    parallel:
        maximumNumberOfProcesses: 8
        minimumNumberOfJobsPerProcess: 2
        processTimeout: 120.0

    # Bootstrap file to set UTF-8 locale
    bootstrapFiles:
        - phpstan-bootstrap.php

    # Laravel Zero specific type extensions
    # stubFiles:
    #     - stubs/laravel-zero.stub (?)

    # Custom rules for Laravel Zero console applications
    customRulesetUsed: true
    
    # Additional Laravel Zero specific checks
    checkOctaneCompatibility: false
    checkBenevolentUnionTypes: true